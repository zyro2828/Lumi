# Copy this file to ".env" and put your real values there.
# NEVER commit the real .env file.

# ---- Providers -------------------------------------------------
# mock   = no external API calls (free, unlimited, for UI testing)
# groq   = Groq Whisper (STT only)
# gemini = Google Gemini (TTS; STT coming later)
STT_PROVIDER=mock
TTS_PROVIDER=mock

# ---- API keys (leave empty if not used) ------------------------
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Models (change here if a model is renamed or retired) -----
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ---- Limits ----------------------------------------------------
MAX_TTS_CHARS=3000
MAX_AUDIO_MB=25

PORT=3000

# ---- Video / FFmpeg --------------------------------------------
MAX_VIDEO_MB=200
# Only needed if "ffmpeg" is not available in your system PATH:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
